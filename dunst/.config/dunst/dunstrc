[global]
    monitor = 0
    follow = mouse

    width = 360
    height = 300
    offset = 20x20
    origin = top-right

    notification_limit = 5

    progress_bar = true
    progress_bar_height = 6

    padding = 16
    horizontal_padding = 16
    text_icon_padding = 12

    frame_width = 0
    frame_color = "#89b4fa"
    separator_color = frame
    highlight = "#89b4fa"

    corner_radius = 12

    font = JetBrainsMono Nerd Font 11

    markup = full
    format = "<b>%s</b>\n%b"

    alignment = left
    word_wrap = true

    idle_threshold = 120
    show_age_threshold = 60

    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#fab387"

transparency = 10
icon_corner_radius = 8
