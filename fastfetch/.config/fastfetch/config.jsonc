{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/greek.png",
    "type": "kitty-icat",
    "height": 32,
    "width": 28,
    "padding": {
      "right": 5,
      "left": 0,
      "top": 0,
      "bottom": 1
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m  \u001b[37m  \u001b[90m  \u001b[37m  \u001b[90m  \u001b[37m  \u001b[90m  \u001b[37m"
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "37"
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "37"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "37"
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "37"
    },
     {
      "type": "packages",
      "key": " ",
      "keyColor": "37"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "37"
    },
    {
      "type": "cpu",
      "key": "󰻠 ",
      "keyColor": "37"
    },
    {
      "type": "gpu",
      "key": " ",
      "keyColor": "37"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m  \u001b[37m  \u001b[90m  \u001b[37m  \u001b[90m  \u001b[37m  \u001b[90m  \u001b[37m"
    },
    "break",
    "break"
  ]
}
