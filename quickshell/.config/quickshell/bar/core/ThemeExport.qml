pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
    id: root

    readonly property bool kitty: true     // ~/.config/kitty/qs-colors.conf + *-theme.auto.conf (+ live reload)
    readonly property bool gtk:   true     // ~/.config/gtk-3.0|4.0/qs-colors.css (+ nudges GTK to reload)
    readonly property bool qt:    true     // ~/.config/qt5ct|qt6ct/colors/qs-theme.conf
    readonly property bool obsidian: true  // qs-theme.css snippet in every Obsidian vault
    readonly property bool obs:      true  // OBS Studio variant theme Yami_Quickshell.ovt
    readonly property bool ayugram:  true  // ~/.local/share/quickshell-bar/telegram.tdesktop-theme
    readonly property bool brave:    true  // BrowserThemeColor policy (needs setup_apps.py --brave once)
    readonly property var obsidianVaults: []   // extra vault folders if Obsidian's own list isn't found

    // ────────────────────────────────────────────────────────────

    readonly property var extras: ({
        "Catppuccin":  { termBg: "#1e1e2e", ansi: ["#45475a","#f38ba8","#a6e3a1","#f9e2af","#89b4fa","#f5c2e7","#94e2d5","#bac2de","#585b70","#f38ba8","#a6e3a1","#f9e2af","#89b4fa","#f5c2e7","#94e2d5","#a6adc8"] },
        "Tokyo Night": { termBg: "#1a1b26", ansi: ["#15161e","#f7768e","#9ece6a","#e0af68","#7aa2f7","#bb9af7","#7dcfff","#a9b1d6","#414868","#f7768e","#9ece6a","#e0af68","#7aa2f7","#bb9af7","#7dcfff","#c0caf5"] },
        "Nord":        { termBg: "#2e3440", ansi: ["#3b4252","#bf616a","#a3be8c","#ebcb8b","#81a1c1","#b48ead","#88c0d0","#e5e9f0","#4c566a","#bf616a","#a3be8c","#ebcb8b","#81a1c1","#b48ead","#8fbcbb","#eceff4"] },
        "Gruvbox":     { termBg: "#282828", ansi: ["#282828","#cc241d","#98971a","#d79921","#458588","#b16286","#689d6a","#a89984","#928374","#fb4934","#b8bb26","#fabd2f","#83a598","#d3869b","#8ec07c","#ebdbb2"] },
        "Dracula":     { termBg: "#282a36", ansi: ["#21222c","#ff5555","#50fa7b","#f1fa8c","#bd93f9","#ff79c6","#8be9fd","#f8f8f2","#6272a4","#ff6e6e","#69ff94","#ffffa5","#d6acff","#ff92df","#a4ffff","#ffffff"] },
        "Rosé Pine":   { termBg: "#191724", ansi: ["#26233a","#eb6f92","#31748f","#f6c177","#9ccfd8","#c4a7e7","#ebbcba","#e0def4","#6e6a86","#eb6f92","#31748f","#f6c177","#9ccfd8","#c4a7e7","#ebbcba","#e0def4"] },
        "Everforest":  { termBg: "#2d353b", ansi: ["#475258","#e67e80","#a7c080","#dbbc7f","#7fbbb3","#d699b6","#83c092","#d3c6aa","#475258","#e67e80","#a7c080","#dbbc7f","#7fbbb3","#d699b6","#83c092","#d3c6aa"] }
    })

    function extra(name, p) {
        return extras[name] || {
            termBg: p.bg,
            ansi: [p.base, p.red, p.green, p.yellow, p.blue, p.accent, p.teal, p.subtext,
                   p.surface0, p.red, p.green, p.yellow, p.blue, p.accent, p.teal, p.text]
        };
    }

    // ── color helpers ───────────────────────────────────────────
    function rgb(h) { return [parseInt(h.substr(1, 2), 16), parseInt(h.substr(3, 2), 16), parseInt(h.substr(5, 2), 16)]; }
    function toHex(a) { return "#" + a.map(v => Math.round(v).toString(16).padStart(2, "0")).join(""); }
    function mix(a, b, t) { const x = rgb(a), y = rgb(b); return toHex(x.map((v, i) => v * (1 - t) + y[i] * t)); }
    function argb(h) { return "#ff" + h.slice(1).toLowerCase(); }

    // ── kitty ───────────────────────────────────────────────────
    function kittyConf(p, x) {
        const L = [
            "# generated by Quickshell (" + Themes.name + ") - edit the palette in Themes.qml instead",
            "foreground " + p.text,
            "background " + x.termBg,
            "selection_foreground " + p.selectedText,
            "selection_background " + p.selected,
            "cursor " + p.text,
            "cursor_text_color " + x.termBg,
            "url_color " + p.blue,
            "active_border_color " + p.accent,
            "inactive_border_color " + p.surface0,
            "bell_border_color " + p.yellow,
            "tab_bar_background " + p.mantle,
            "active_tab_foreground " + p.base,
            "active_tab_background " + p.accent,
            "inactive_tab_foreground " + p.subtext,
            "inactive_tab_background " + p.surface0
        ];
        for (let i = 0; i < 16; i++) L.push("color" + i + " " + x.ansi[i]);
        return L.join("\n");
    }

    // ── GTK (libadwaita names; adw-gtk3 honors them too) ────────
    function gtkColors(p, x) {
        const shade = "rgba(0, 0, 0, 0.36)";
        const m = [
            ["accent_color", p.accent], ["accent_bg_color", p.accent], ["accent_fg_color", p.base],
            ["destructive_color", p.red], ["destructive_bg_color", p.red], ["destructive_fg_color", p.base],
            ["success_color", p.green], ["success_bg_color", p.green], ["success_fg_color", p.base],
            ["warning_color", p.yellow], ["warning_bg_color", p.yellow], ["warning_fg_color", p.base],
            ["error_color", p.red], ["error_bg_color", p.red], ["error_fg_color", p.base],
            ["window_bg_color", x.termBg], ["window_fg_color", p.text],
            ["view_bg_color", x.termBg], ["view_fg_color", p.text],
            ["headerbar_bg_color", p.mantle], ["headerbar_fg_color", p.text],
            ["headerbar_border_color", p.surface0], ["headerbar_backdrop_color", x.termBg],
            ["card_bg_color", p.surface0], ["card_fg_color", p.text],
            ["dialog_bg_color", x.termBg], ["dialog_fg_color", p.text],
            ["popover_bg_color", p.mantle], ["popover_fg_color", p.text],
            ["sidebar_bg_color", p.mantle], ["sidebar_fg_color", p.text], ["sidebar_backdrop_color", x.termBg],
            ["secondary_sidebar_bg_color", p.mantle], ["secondary_sidebar_fg_color", p.text],
            ["thumbnail_bg_color", p.surface0], ["thumbnail_fg_color", p.text],
            ["shade_color", shade], ["card_shade_color", shade], ["headerbar_shade_color", shade],
            ["scrollbar_outline_color", "rgba(0, 0, 0, 0.5)"]
        ];
        return "/* generated by Quickshell (" + Themes.name + ") */\n"
            + m.map(e => "@define-color " + e[0] + " " + e[1] + ";").join("\n");
    }
    function gtk4Css(p, x) { return gtkColors(p, x); }
    function gtk3Css(p, x) {                 // plain Adwaita (GTK3) still uses the old theme_* names
        const legacy = [
            ["theme_bg_color", x.termBg], ["theme_fg_color", p.text],
            ["theme_base_color", p.mantle], ["theme_text_color", p.text],
            ["theme_selected_bg_color", p.accent], ["theme_selected_fg_color", p.base],
            ["theme_unfocused_bg_color", x.termBg], ["theme_unfocused_fg_color", p.text],
            ["theme_unfocused_base_color", p.mantle], ["theme_unfocused_text_color", p.text],
            ["theme_unfocused_selected_bg_color", p.accent], ["theme_unfocused_selected_fg_color", p.base],
            ["insensitive_bg_color", mix(x.termBg, p.surface0, 0.5)], ["insensitive_fg_color", p.subtext],
            ["borders", p.surface0], ["unfocused_borders", p.surface0],
            ["content_view_bg", p.mantle]
        ];
        return gtkColors(p, x) + "\n" + legacy.map(e => "@define-color " + e[0] + " " + e[1] + ";").join("\n");
    }

    // ── Qt (qt5ct / qt6ct palette file) ─────────────────────────
    function qtConf(p, x) {
        const dim = c => mix(c, x.termBg, 0.5);
        const base = [
            p.text, p.surface0, p.selected, mix(p.surface0, p.selected, 0.5), p.base, p.mantle,   // windowText button light midlight dark mid
            p.text, p.selectedText, p.text, p.mantle, x.termBg, p.base,                            // text brightText buttonText base window shadow
            p.accent, p.base, p.blue, p.accent, p.surface0, x.termBg,                              // highlight highlightedText link linkVisited alternateBase noRole
            p.mantle, p.text, p.subtext                                                            // toolTipBase toolTipText placeholderText
        ];
        const disabled = base.slice();
        [0, 6, 8, 20].forEach(i => disabled[i] = dim(p.text));   // windowText text buttonText placeholder
        disabled[12] = p.selected;                                // highlight
        disabled[13] = dim(p.text);                               // highlightedText
        const fmt = a => a.map(argb).join(", ");
        return "[ColorScheme]\nactive_colors=" + fmt(base)
            + "\ninactive_colors=" + fmt(base)
            + "\ndisabled_colors=" + fmt(disabled) + "\n";
    }

    // ── write files + reload ────────────────────────────────────
    readonly property string script: `
        w() { mkdir -p "$(dirname "$1")" && printf '%s\\n' "$2" > "$1"; }
        if [ "$5" = 1 ]; then
            w "$HOME/.config/kitty/qs-colors.conf" "$1"
            # kitty's automatic light/dark theme files override kitty.conf, so they must carry our colors too
            for f in dark-theme.auto.conf light-theme.auto.conf no-preference-theme.auto.conf; do
                t="$HOME/.config/kitty/$f"
                [ -f "$t" ] && [ ! -e "$t.qs-backup" ] && ! grep -q "generated by Quickshell" "$t" && cp "$t" "$t.qs-backup"
                w "$t" "$1"
            done
            pkill -USR1 -x kitty 2>/dev/null
        fi
        if [ "$7" = 1 ]; then
            [ -d "$HOME/.config/qt6ct" ] && { w "$HOME/.config/qt6ct/colors/qs-theme.conf" "$4"; touch "$HOME/.config/qt6ct/qt6ct.conf"; }
            [ -d "$HOME/.config/qt5ct" ] && { w "$HOME/.config/qt5ct/colors/qs-theme.conf" "$4"; touch "$HOME/.config/qt5ct/qt5ct.conf"; }
        fi
        if [ "$6" = 1 ]; then
            w "$HOME/.config/gtk-4.0/qs-colors.css" "$2"
            # GTK3 never re-reads ~/.config/gtk-3.0/gtk.css in running apps, so it is themed through
            # generated themes instead; switching the theme NAME makes open GTK3 apps (Nemo...) reload.
            w "$HOME/.config/gtk-3.0/qs-colors.css" "/* superseded: GTK3 follows the generated qs-theme-a/b themes */"
            if command -v gsettings >/dev/null; then
                cache="$HOME/.cache/quickshell-bar"; mkdir -p "$cache"
                cur=$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'")
                case "$cur" in qs-theme-*) ;; ?*) printf '%s' "$cur" > "$cache/base-gtk-theme" ;; esac
                base=$(cat "$cache/base-gtk-theme" 2>/dev/null)
                case "$base" in Adwaita|Adwaita-dark|"") base=adw-gtk3-dark ;; esac
                basecss=""
                for d in "$HOME/.themes" "$HOME/.local/share/themes" /usr/share/themes; do
                    if [ -f "$d/$base/gtk-3.0/gtk.css" ]; then basecss="file://$d/$base/gtk-3.0/gtk.css"; break; fi
                done
                [ -z "$basecss" ] && basecss="resource:///org/gtk/libgtk/theme/Adwaita/gtk-contained-dark.css"
                if [ "$(cat "$cache/gtk-flip" 2>/dev/null)" = a ]; then n=b; else n=a; fi
                printf '%s' "$n" > "$cache/gtk-flip"
                t="$HOME/.local/share/themes/qs-theme-$n"
                mkdir -p "$t/gtk-3.0"
                printf '[Desktop Entry]\nType=X-GNOME-Metatheme\nName=qs-theme-%s\nComment=Generated by Quickshell\nEncoding=UTF-8\n\n[X-GNOME-Metatheme]\nGtkTheme=qs-theme-%s\n' "$n" "$n" > "$t/index.theme"
                printf '@import url("%s");\n%s\n' "$basecss" "$3" > "$t/gtk-3.0/gtk.css"
                gsettings set org.gnome.desktop.interface color-scheme prefer-dark 2>/dev/null
                gsettings set org.gnome.desktop.interface gtk-theme "qs-theme-$n" 2>/dev/null
            fi
        fi
    `

    property bool pending: false
    property bool appsPending: false

    function exportApps() {
        if (appsProc.running) { appsPending = true; return; }
        const p = Themes.current;
        const x = extra(Themes.name, p);
        appsProc.command = ["python3", Quickshell.shellPath("tools/export_apps.py"), JSON.stringify({
            name: Themes.name, palette: p, termBg: x.termBg,
            options: { obsidian: obsidian, obs: obs, ayugram: ayugram, brave: brave, obsidianVaults: obsidianVaults }
        })];
        appsProc.running = true;
    }

    function exportAll() {
        exportApps();
        if (proc.running) { pending = true; return; }
        const p = Themes.current;
        const x = extra(Themes.name, p);
        proc.command = ["bash", "-c", script, "qs-theme",
            kittyConf(p, x), gtk4Css(p, x), gtk3Css(p, x), qtConf(p, x),
            kitty ? "1" : "0", gtk ? "1" : "0", qt ? "1" : "0"];
        proc.running = true;
    }

    Process {
        id: proc
        onExited: if (root.pending) { root.pending = false; root.exportAll(); }
    }

    Process {
        id: appsProc
        onExited: if (root.appsPending) { root.appsPending = false; root.exportApps(); }
    }
}
